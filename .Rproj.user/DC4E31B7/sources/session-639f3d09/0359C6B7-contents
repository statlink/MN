library(Rfast) ## we need this for Var         
      
tau <- function(x, y) {

  n1 <- length(x)
  n2 <- length(y)
  sd1 <- Var(x)
  sd2 <- Var(y)
  s_d <- sqrt( sd1/n1 + sd2/n2) # s_delta

  defre <- s_d^4 / ( ( ( sd1/n1 )^2 ) / (n1-1) + (sd2/n2)^2 / (n2-1) )

  ti <- ( mean(x) - mean(y) ) / s_d

  list(ti = ti, defre = defre)
}


