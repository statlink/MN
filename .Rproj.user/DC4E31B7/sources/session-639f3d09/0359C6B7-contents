pame <- function(x,y){
 stilx <- dim(x)[2]
 stily <- dim(y)[2]
 n1  <- dim(x)[1]
 n2  <- dim(y)[2]

     ti    <- matrix()
     df    <- matrix()
     pv    <- matrix()

     for( i in 1:stilx){

             mx1 <- mean(x[,i])
             mx2 <- mean(y[,i])
             vx1 <- var(x[,i])
             vx2 <- var(y[,i])

             ee  <- (vx1/n1)+(vx2/n2)
             sdw <- sqrt(ee)
             ti[i]   <- (mx1 - mx2)/sdw
             dfa <-  ee^2
             dfp <- ( ( vx1 / n1 )^2 ) / ( n1 -1) + ( ( vx2/ n2 )^2 ) / ( n2 -1 )
             df[i]  <-  dfa/dfp
             pv[i]   <- 2 * (1 - pt(abs(ti[i]),df[i]))
      }

  out <- list(ti=ti, df= df , pv=pv)
  out
}


