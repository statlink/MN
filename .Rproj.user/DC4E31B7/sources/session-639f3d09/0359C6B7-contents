## t-test

## Antonis
Wtest <- function(x1,x2){
         mx1 <- mean(x1)
         mx2 <- mean(x2)
         vx1 <- var(x1)
         vx2 <- var(x2)
         n1  <- length(x1)
         n2  <- length(x2)
         ee  <- (vx1/n1)+(vx2/n2)
         sdw <- sqrt(ee)
         t   <- (mx1 - mx2)/sdw 
         dfa <-  ee^2
         dfp <- ( ( vx1 / n1 )^2 ) / (n1 - 1) + ( ( vx2 / n2 )^2 )/(n2-1)
         df  <-  dfa/dfp
         out <- list( "tstat-Welch"=t , "degrees of freedom"=df)
         out 
}
         

