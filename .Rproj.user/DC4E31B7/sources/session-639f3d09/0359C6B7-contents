## Giorgos
Welch <- function(a,b){
meanA <- mean(a)
meanB <- mean(b)

na <- length(a)
nb <- length(b)

vara <- var(a)
varb <- var(b)
sds <- sqrt( (vara/na)+ (varb/nb) )

t <- (meanA - meanB)/ sds

d.f <- ( vara/na + varb/nb ) ^2 / ((vara/na) ^2/(na-1) + (varb /nb) ^2/(nb-1))
list(t=t, d.f=d.f)
} 

