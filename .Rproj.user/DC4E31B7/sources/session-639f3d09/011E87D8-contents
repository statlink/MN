x <- as.matrix( iris[, 1:4] )

## stupid way
y <- x
## altenrative way
y <- matrix(nrow = 150, ncol = 4)
for ( i in 1:dim(x)[1] ) {
  y[i, ] <- x[i, ] / sum(x[i, ])
}

## optimal way
library(Rfast)
y <- x / rowsums(x)

m <- colmeans(x)
s <- colVars(x, std = TRUE)
z <- (x - m)/s ## wrong standardisation
colmeans(z)
colVars(z)

z <- t( ( t(x) - m )/s )  ## correct standardisation
colmeans(z)
colVars(z)

## standardisation with for loop
m <- numeric(4)
s <- numeric(4)
z <- x
for (i in 1:4) {
  m[i] <- mean(x[, i])
  s[i] <- sd(x[, i])
}
for (i in 1:150) {
  z[i, ] <- (x[i, ] - m) / s
}

## more elegant for loops
m <- apply(x, 2, mean) ## colmeans(x)
s <- apply(x, 2, sd)  ## colVars(x, std = TRUE)

m <- apply(x, 1, mean) ## rowmeans(x)
s <- apply(x, 1, sd) ## rowsVars(x, std = TRUE)



































