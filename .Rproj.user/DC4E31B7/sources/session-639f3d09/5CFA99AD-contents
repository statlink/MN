## functions
## linear regression
linreg <- function(x, y) {

  ## x can be a vector or a matrix
  ## y must be a vector

  x <- cbind(1, x) ## design matrix

  n <- dim(x)[1]
  p <- dim(x)[2]
  #betas <- solve( crossprod(x), crossprod(x, y) )  ## (X^T * X)^(-1) * X^T * Y
  invxx <- solve( crossprod(x) )
  betas <- invxx %*% crossprod(x, y)
  yhat <- as.vector( x %*% betas )
  res <- y - yhat
  sse <- sum(res^2)
  sigma2 <- sse / (n - p)
  ## var of betas is sigma2 * (X^T * X) ^(-1)
  sebetas <- sqrt( sigma2 * diag( invxx ) )
  tstats <- betas / sebetas
  pvalues <- 2 * pt( abs(tstats), n - p, lower.tail = FALSE )
  sst <- sum( (y - mean(y) )^2 )
  r2 <- 1 - sse / sst
  pinakas <- cbind(betas, sebetas, tstats, pvalues)
  colnames(pinakas) <- c( "betas", "se of betas", "t-statistics", "p-values" )

  list(pinakas = pinakas, variance = sigma2, r.square = r2, yhat = yhat, residuals = res)
}

