mn.reg2_fast <- function(Y, x, tol = 1e-6, max_iter = 5000) {
  
  tic <- proc.time()
  k <- length(Y)
  dm <- dim(Y[[1]])
  n <- dm[1]; p <- dm[2]
  
  x <- model.matrix(~., data = as.data.frame(x))
  q <- ncol(x)
  
  ones <- matrix(1, nrow = n, ncol = 1)
  tones <- t(ones)
  xx <- crossprod(x)
  con <- -0.5 * k * n * p * log(2 * pi)
  
  # Initial B via OLS on column means
  Ybar <- t(sapply(Y, colMeans))
  B <- solve(xx, crossprod(x, Ybar))
  
  # Initial residuals and covariances
  E <- lapply(1:k, function(i) Y[[i]] - ones %*% (x[i, , drop = FALSE] %*% B))
  U <- V <- 0
  for (i in 1:k) {
    U <- U + tcrossprod(E[[i]])
    V <- V + crossprod(E[[i]])
  }
  U <- U / (k * p); V <- V / (k * n)
  
  # Initial log-likelihood (without constant)
  invU <- solve(U); invV <- solve(V)
  ldU <- as.numeric(determinant(U, log=TRUE)$modulus)
  ldV <- as.numeric(determinant(V, log=TRUE)$modulus)
  S <- Reduce('+', lapply(E, function(e) t(e) %*% invU %*% e))
  tr <- sum(diag(invV %*% S))
  loglik_old <- -0.5*k*p*ldU - 0.5*k*n*ldV - 0.5*tr
  
  iter <- 1
  while (iter <= max_iter) {
    invU <- solve(U); invV <- solve(V)
    
    # Update B
    cU <- as.numeric(tones %*% invU %*% ones)
    Z <- t(sapply(Y, function(Yi) (tones %*% invU %*% Yi) / cU))
    B <- solve(xx, crossprod(x, Z))
    
    # Update residuals
    E <- lapply(1:k, function(i) Y[[i]] - ones %*% (x[i, , drop = FALSE] %*% B))
    
    # ---- Gauss-Seidel updates ----
    # Update U using old invV
    U <- 0
    for (i in 1:k) U <- U + E[[i]] %*% invV %*% t(E[[i]])
    U <- U / (k * p)
    
    # Update V using new invU
    invU_new <- solve(U)
    V <- 0
    for (i in 1:k) V <- V + t(E[[i]]) %*% invU_new %*% E[[i]]
    V <- V / (k * n)
    
    # ---- Compute new log-likelihood ----
    invU <- solve(U); invV <- solve(V)
    ldU <- as.numeric(determinant(U, log=TRUE)$modulus)
    ldV <- as.numeric(determinant(V, log=TRUE)$modulus)
    S <- Reduce('+', lapply(E, function(e) t(e) %*% invU %*% e))
    tr <- sum(diag(invV %*% S))
    loglik_new <- -0.5*k*p*ldU - 0.5*k*n*ldV - 0.5*tr
    
    # Relative change
    if (abs(loglik_new - loglik_old) / abs(loglik_old) < tol) break
    
    loglik_old <- loglik_new
    iter <- iter + 1
  }
  
  # Names and output as before...
  if (is.null(colnames(x))) rownames(B) <- paste0("X", 1:q)
  else rownames(B) <- colnames(x)
  if (is.null(colnames(Y[[1]]))) colnames(B) <- paste0("Y", 1:p)
  else colnames(B) <- colnames(Y[[1]])
  
  fitted <- lapply(1:k, function(i) ones %*% (x[i, , drop=FALSE] %*% B))
  
  runtime <- proc.time() - tic
  out <- list(runtime = runtime, iters = iter, loglik = con + loglik_new,
              B = B, U = U, V = V, fitted = fitted, x = x, n = n)
  class(out) <- "mn.reg_subject"
  return(out)
}