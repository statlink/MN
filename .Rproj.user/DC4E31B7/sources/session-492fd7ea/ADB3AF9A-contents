\examples{
M <- as.matrix(iris[1:8, 1:4])
U <- cov( matrix( rnorm(100 * 8), ncol = 8 ) )
V <- cov( iris[1:50, 1:4] )
Y <- MN::rmn(150, M, U, V)
x <- iris[, 1:2]
colnames(x) <- c("sepal-length", "sepal-width")
mod <- mn.reg2(Y, x)


M <- as.matrix(iris[1:8, 1:4])
U <- cov( matrix( rnorm(100 * 8), ncol = 8 ) )
V <- cov( iris[1:50, 1:4] )
X <- MN::rmn(150, M/3, U, V)

mod <- mn.reg(Y, X)
}
